<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped.
         TCL G13: YouTube, Apple TV, Disney+ Hotstar, Prime Video. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>in.startv.hotstar</item>
        <item>com.amazon.amazonvideo.livingroom</item>
    </string-array>

    <!-- Grid order after the dock. Apps listed here appear first, in this order; anything not
         listed follows alphabetically. The dock apps stay in the dock (dock_apps above).
         A pushed theme's config.json can override this with an "app_order" array, no rebuild. -->
    <string-array name="app_order">
        <item>tv.airtel.xstream.tvapp</item>          <!-- Airtel Xstream Play -->
        <item>com.tcl.waterfall.overseas</item>       <!-- TCL Channel -->
        <item>com.netflix.ninja</item>                <!-- Netflix -->
        <item>com.graymatrix.did</item>               <!-- ZEE5 -->
        <item>com.stremio.one</item>                  <!-- Stremio (official Android TV APK) -->
        <item>com.spotify.tv.android</item>           <!-- Spotify (Play Store) -->
    </string-array>

    <!-- Apps never shown as tiles: the MediaTek tuner (it still appears in the Inputs
         dropdown), the TV's quick panel, and Settings (which has its own pill). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.tcl.suspension</item>
        <item>com.android.tv.settings</item>
        <item>com.google.android.youtube.tvmusic</item> <!-- uninstalled for user 0; stays hidden if restored -->
        <item>com.phlox.tvwebbrowser</item> <!-- removed in favour of Stremio; keeps it hidden if reinstalled -->
    </string-array>

    <!-- Your name, appended to the greeting: "Good afternoon, Vedarth".
         Leave empty for a plain greeting. -->
    <string name="user_name" translatable="false">Vedarth</string>

    <!-- Weather shown under the date on Home and on the screensaver. Open-Meteo needs no API key.
         Set the city label as you want it displayed, and the coordinates for your city.
         Leave weather_city empty to hide the weather line entirely. -->
    <string name="weather_city" translatable="false">Jaipur</string>
    <string name="weather_lat" translatable="false">26.9124</string>
    <string name="weather_lon" translatable="false">75.7873</string>
    <string name="weather_units" translatable="false">celsius</string>
    <!-- Append the US AQI to the weather line. One extra tiny Open-Meteo request per refresh; it is
         a short text result only (no image, no cache file), so the RAM cost is negligible. -->
    <bool name="weather_aqi">true</bool>

    <!-- Optional photo slideshow behind the screensaver clock, downloaded from the internet.
         OFF by default: when on, the dream holds one bitmap in RAM while it runs (~1.8 MB at 720p,
         ~4 MB at 1080p) plus a second one briefly during a refresh. APK impact is ~6 KB.
         {w}/{h} are replaced with the screen size and {n} with a cache-buster.
         Set to "on" to enable. -->
    <string name="ambient_photos" translatable="false">off</string>
    <string name="ambient_photo_url" translatable="false">https://picsum.photos/{w}/{h}?random={n}</string>
    <string name="ambient_photo_minutes" translatable="false">10</string>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The VPN badge shows for any VPN either way. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- "Default home" tile that opens Android's home-screen picker, for TVs whose settings have one
         (most Android TVs don't; the tile only appears when the page exists). Off by default. -->
    <bool name="show_home_settings_shortcut">false</bool>
</resources>
