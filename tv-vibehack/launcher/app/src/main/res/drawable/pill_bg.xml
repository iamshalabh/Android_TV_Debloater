<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS/iOS style frosted pill: a soft vertical sheen under a bright 1dp rim.
     Layers only — no blur, so it costs nothing to draw. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#42FFFFFF"
                        android:centerColor="#1FFFFFFF"
                        android:endColor="#0FFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
