<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): greeting, analog clock and date drifting around a black screen over
     two soft ambient glows. No images: everything here is drawn, so a 1 GB TV stays happy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/dreamAmbient2"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dreamGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:textColor="#59FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/schibsted"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:includeFontPadding="false" />

        <com.gathin.tvhome.AnalogClockView
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/schibsted"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/dreamWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:textColor="#8CFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/schibsted"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
