<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): greeting, analog clock and date drifting around a black screen over
     two soft ambient glows. No images: everything here is drawn, so a 1 GB TV stays happy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <View
        android:id="@+id/dreamScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:visibility="gone" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/dreamAmbient2"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/dreamGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:textColor="#8CFFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/schibsted"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.04"
            android:includeFontPadding="false" />

        <com.gathin.tvhome.AnalogClockView
            android:layout_width="360dp"
            android:layout_height="360dp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#A6FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/schibsted"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.02" />

        <LinearLayout
            android:id="@+id/dreamWeatherRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/dreamWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8CFFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/schibsted"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.02" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
